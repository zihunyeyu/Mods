  <Properties>
    <Name>20th Century Fantasy Extension Package</Name>
    <Description>Extension Pack for 20th Century Fantasy Civilizations or Leaders.</Description>
    <Created>1744463305</Created>
    <Teaser>Extension Pack for 20th Century Civilizations or Leaders</Teaser>
    <Authors>normal person</Authors>
    <SpecialThanks>History</SpecialThanks>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>0</SupportsHotSeat>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
